# Email via Resend (reemplaza Gmail SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Avisos de pago por correo reenviado (Cobranzas → Bandeja).
# Secreto que tiene que traer el webhook de Resend en la URL:
#   https://xavia-self.vercel.app/api/cobranzas/email?token=EL_VALOR_DE_ACA
# Sin esta variable el endpoint queda apagado: es preferible no recibir nada a recibir
# de cualquiera.
COBRANZAS_EMAIL_TOKEN=un-secreto-largo-al-azar

# Lectura de avisos de pago con IA (Cobranzas → Bandeja). Es un RESPALDO: solo se llama
# cuando el lector por patrones no encontró el importe — típicamente cuando el dato está
# en un PDF adjunto. Sin esta variable todo sigue funcionando, solo que esos avisos hay
# que cargarlos a mano.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
